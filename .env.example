# MongoDB connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional, defaults to "instagram_tracker"
MONGODB_DB=instagram_tracker

# Google OAuth — see README "Configuring Google OAuth" for step-by-step setup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string, used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional — only needed if you want to override the auto-detected callback
# URL (the app normally derives it from the request's own host).
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
